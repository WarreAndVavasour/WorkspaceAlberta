# Shell scripts and systemd units must be LF. A CRLF shebang makes the file
# unexecutable on Linux (`/usr/bin/env: 'bash\r': No such file or directory`),
# which silently broke the Pi appliance installer when authored on Windows.
*.sh            text eol=lf
*.desktop       text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
Procfile        text eol=lf

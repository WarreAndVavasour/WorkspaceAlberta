# Open-model provider keys for OpenCode. Copy to .env and fill locally.
# Never commit real keys.

# Z.AI / GLM
ZAI_API_KEY=

# Hugging Face Inference Providers
HF_TOKEN=

# DeepSeek
DEEPSEEK_API_KEY=

# Cohere Command A+ review and Cohere Parse document layer (same key).
COHERE_API_KEY=

# TypeSafe Jev classifier for pipelines/requirement_classifier (https://docs.typesafe.ai)
TYPESAFE_API_KEY=
# Optional. Defaults to parse-v5.0. Used by process_bid_room inside E2B.
# COHERE_PARSE_MODEL=parse-v5.0

# Hosted OAuth 2.1 (placeholders only — never commit real values).
# WA_PUBLIC_ORIGIN=https://elbowsupknivesout.warreandvavasour.com
# WA_PUBLIC_MCP_URL=https://elbowsupknivesout.warreandvavasour.com/mcp
# WA_OAUTH_SIGNING_KEY=replace-with-a-long-random-string
# WA_HOSTED=1
# WA_SMTP_HOST=
# WA_SMTP_PORT=587
# WA_SMTP_USER=
# WA_SMTP_PASSWORD=

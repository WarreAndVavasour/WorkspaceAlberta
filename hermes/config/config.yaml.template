# Workspace Alberta Hermes config template
# This is intentionally minimal. The installer sets these values with `hermes config set`
# so it can preserve an existing Hermes config file.

dashboard:
  theme: workspace-alberta

# Headless Chromium CDP endpoint for the Browser Use automation backend (browser_exec).
# Leave backend unset so Browser Use stays the default when the browser-use CLI is runnable.
browser:
  cdp_url: http://127.0.0.1:9225

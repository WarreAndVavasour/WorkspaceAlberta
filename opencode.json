{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["zai", "huggingface", "deepseek", "cohere"],
  "disabled_providers": ["openai"],
  "instructions": ["AGENTS.md", ".cursor/rules/*.mdc"],
  "default_agent": "procurement",
  "provider": {
    "zai": {
      "options": {
        "apiKey": "{env:ZAI_API_KEY}"
      }
    },
    "huggingface": {
      "options": {
        "apiKey": "{env:HF_TOKEN}"
      }
    },
    "deepseek": {
      "options": {
        "timeout": 600000,
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "cohere": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cohere",
      "options": {
        "baseURL": "https://api.cohere.ai/compatibility/v1",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "command-a-plus-05-2026": {
          "name": "Command A+"
        }
      }
    }
  },
  "mcp": {
    "buildcanada": {
      "type": "local",
      "command": ["python", "mcp-servers/canadabuys/server.py"],
      "enabled": true,
      "timeout": 15000
    },
    "openaiDeveloperDocs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "cloudflare": { "type": "remote", "url": "https://mcp.cloudflare.com/mcp", "enabled": true, "oauth": {}, "timeout": 15000 },
    "cloudflare-docs": { "type": "remote", "url": "https://docs.mcp.cloudflare.com/mcp", "enabled": true, "timeout": 15000 },
    "cloudflare-bindings": { "type": "remote", "url": "https://bindings.mcp.cloudflare.com/mcp", "enabled": true, "oauth": {}, "timeout": 15000 },
    "cloudflare-builds": { "type": "remote", "url": "https://builds.mcp.cloudflare.com/mcp", "enabled": true, "oauth": {}, "timeout": 15000 },
    "cloudflare-observability": { "type": "remote", "url": "https://observability.mcp.cloudflare.com/mcp", "enabled": true, "oauth": {}, "timeout": 15000 }
  },
  "agent": {
    "procurement": {
      "description": "Primary agent for Build Canada procurement work, MCP maintenance, and open-model (GLM, DeepSeek, Cohere, Hugging Face) integration in this repo.",
      "mode": "primary",
      "prompt": "{file:.opencode/agents/procurement.md}",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow"
      }
    },
    "review": {
      "description": "Read-only review agent for procurement logic, MCP behavior, and documentation drift.",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/review.md}",
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "python -m unittest*": "allow"
        }
      }
    }
  },
  "command": {
    "smoke": {
      "description": "Run the CanadaBuys MCP smoke test and summarize the result.",
      "template": "Run `python -m unittest tests.test_canadabuys_mcp_smoke` and summarize the result. If it fails, diagnose the problem before proposing changes.",
      "agent": "procurement"
    }
  }
}
